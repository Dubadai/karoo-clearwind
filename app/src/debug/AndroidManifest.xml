<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: lets adb fake a remote button press for testing. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".DebugRemoteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.daviddokakis.clearwind.DEBUG_REMOTE" />
            </intent-filter>
        </receiver>
        <!-- Field gallery: the field at every Karoo size, light and dark (design-assets/tools/field-gallery) -->
        <receiver
            android:name=".FieldGalleryReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.daviddokakis.clearwind.DEBUG_GALLERY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
